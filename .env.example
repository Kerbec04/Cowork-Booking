# Copy this file to .env and fill in real values.
# Never commit .env — it is already listed in .gitignore.

# --- Database (Neon Postgres) ---------------------------------------------
# Pooled connection string, used at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (unpooled) connection, required by Neon for `prisma migrate`.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (NextAuth.js / Auth.js) ------------------------------------------
# Generate with: npx auth secret
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments ---------------------------------------------------------------
# MVP: pagamento é feito presencialmente na recepção (sem gateway online).
# Chaves abaixo ficam reservadas para quando/se um gateway online for
# habilitado no futuro (Mercado Pago é o mais indicado para Pix no Brasil).
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_PUBLIC_KEY=""

# --- E-mail (confirmações de reserva) ---------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Coworking Booking <reservas@example.com>"
